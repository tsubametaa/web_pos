---
import { SERVICES_DATA } from '../../data/companyData';
import { CheckCircle2, ArrowRight, Armchair, Layers } from 'lucide-astro';

const serviceIcons = {
  Armchair: Armchair,
  Layers: Layers,
};
---

<section id="layanan" class="py-20 bg-theme-main border-t border-theme">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-block">
        <div class="tech-tag">
          <span>LAYANAN UTAMA WORKSHOP</span>
        </div>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-theme-main tracking-tight">
        Dua Spesialisasi Terbaik Dalam <span class="text-brand">Satu Atap</span>
      </h2>
      <p class="text-theme-muted text-base">
        Kami menyediakan jasa pembuatan interior furnitur kustom modern serta instalasi pertukangan aluminium komprehensif.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {SERVICES_DATA.map((service: any) => {
        const IconComponent = serviceIcons[service.icon as keyof typeof serviceIcons] || Layers;
        return (
          <div class="service-card rounded-md p-8 bg-theme-card border border-theme hover:border-brand shadow-theme transition-all duration-200 group flex flex-col justify-between">
            <div class="space-y-6">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-sm bg-brand-light border border-theme-brand text-brand font-mono font-bold text-xs uppercase tracking-wider">
                  {service.badge}
                </span>
                <span class="text-[10px] font-mono font-semibold text-theme-subtle uppercase">KARYA SEJATI DIVISION</span>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 rounded-md bg-brand-light border border-theme-brand text-brand flex items-center justify-center shrink-0">
                  <IconComponent class="w-6 h-6 text-brand" />
                </div>
                <div>
                  <h3 class="text-2xl font-extrabold text-theme-main group-hover:text-brand transition-colors">
                    {service.title}
                  </h3>
                  <p class="text-xs font-semibold text-theme-subtle mt-1 font-mono uppercase">
                    {service.subtitle}
                  </p>
                </div>
              </div>

              <p class="text-theme-muted text-sm leading-relaxed">
                {service.description}
              </p>

              <!-- Features List -->
              <ul class="space-y-3 pt-2">
                {service.features.map((feat: string) => (
                  <li class="flex items-center space-x-3 text-sm text-theme-main font-medium">
                    <CheckCircle2 class="w-4 h-4 text-brand shrink-0" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 mt-6 border-t border-theme">
              <a
                href="#etalase"
                class="inline-flex items-center text-sm font-bold text-brand hover:text-brand-hover transition-colors group-hover:translate-x-1 duration-200"
              >
                <span>Jelajahi Produk {service.title}</span>
                <ArrowRight class="w-4 h-4 ml-1.5" />
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<script>
  import { inView, animate } from 'motion';

  inView('#layanan', () => {
    const cards = document.querySelectorAll('.service-card');
    if (cards.length > 0) {
      animate(cards as any, { opacity: [0, 1], y: [30, 0] }, { duration: 0.6, delay: 0.1 });
    }
  });
</script>



