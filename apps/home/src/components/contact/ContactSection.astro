---
import { COMPANY_INFO } from "../../data/companyData";
import Dropdown from "../etalase/layout/Dropdown.astro";
import { MapPin, Phone, Mail, Send, Clock, MessageSquare } from "lucide-astro";

const categoryOptions = [
  { value: "Furnitur Custom (Kitchen Set / Lemari)", label: "Furnitur Custom (Kitchen Set / Lemari)" },
  { value: "Kusen & Pintu Aluminium", label: "Kusen & Pintu Aluminium" },
  { value: "Jendela & Partisi Kaca", label: "Jendela & Partisi Kaca" },
  { value: "Kanopi & Proyek Lainnya", label: "Kanopi & Proyek Lainnya" },
];
---

<section id="kontak" class="py-20 bg-theme-main relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Info & Address -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-3">
          <h2
            class="text-3xl sm:text-4xl font-extrabold text-theme-main tracking-tight"
          >
            Hubungi <span class="text-brand">Kami</span>
          </h2>
          <p class="text-theme-muted text-sm leading-relaxed">
            Siap mendiskusikan rencana furnitur custom atau kebutuhan aluminium
            bangunan Anda. Datang langsung ke bengkel atau hubungi kami secara
            fleksibel.
          </p>
        </div>

        <div class="space-y-4">
          <!-- Address Card -->
          <div
            class="p-5 rounded-md bg-theme-card border border-theme flex items-start space-x-4 hover:border-brand transition-colors"
          >
            <div
              class="w-10 h-10 rounded-md bg-brand-light border border-theme-brand text-brand flex items-center justify-center shrink-0 font-bold"
            >
              <MapPin class="w-5 h-5 text-brand" />
            </div>
            <div class="space-y-1">
              <p
                class="text-[10px] font-mono font-bold text-theme-subtle uppercase"
              >
                Alamat Workshop
              </p>
              <p class="text-sm font-semibold text-theme-main leading-snug">
                {COMPANY_INFO.address}
              </p>
            </div>
          </div>

          <!-- Phone Card -->
          <div
            class="p-5 rounded-md bg-theme-card border border-theme flex items-start space-x-4 hover:border-brand transition-colors"
          >
            <div
              class="w-10 h-10 rounded-md bg-brand-light border border-theme-brand text-brand flex items-center justify-center shrink-0 font-bold"
            >
              <Phone class="w-5 h-5 text-brand" />
            </div>
            <div class="space-y-1">
              <p
                class="text-[10px] font-mono font-bold text-theme-subtle uppercase"
              >
                Telepon & WhatsApp
              </p>
              <p class="text-sm font-semibold text-theme-main">
                {COMPANY_INFO.phone}
              </p>
              <div
                class="flex items-center space-x-1.5 text-xs text-emerald-500 font-bold font-mono"
              >
                <Clock class="w-3.5 h-3.5" />
                <span>Respon Cepat 08:00 - 17:00 WIB</span>
              </div>
            </div>
          </div>

          <!-- Email Card -->
          <div
            class="p-5 rounded-md bg-theme-card border border-theme flex items-start space-x-4 hover:border-brand transition-colors"
          >
            <div
              class="w-10 h-10 rounded-md bg-brand-light border border-theme-brand text-brand flex items-center justify-center shrink-0 font-bold"
            >
              <Mail class="w-5 h-5 text-brand" />
            </div>
            <div class="space-y-1">
              <p
                class="text-[10px] font-mono font-bold text-theme-subtle uppercase"
              >
                Email Resmi
              </p>
              <p class="text-sm font-semibold text-theme-main">
                {COMPANY_INFO.email}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="lg:col-span-7 p-5 sm:p-8 rounded-md bg-theme-card border border-theme shadow-theme space-y-6"
      >
        <div>
          <h3 class="text-xl font-extrabold text-theme-main">
            Kirim Pesan Konsultasi
          </h3>
          <p class="text-xs text-theme-subtle mt-1 font-medium">
            Isi formulir singkat di bawah ini untuk mengirim estimasi proyek
            Anda langsung via WhatsApp.
          </p>
        </div>

        <form id="inquiry-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="contact-name"
                class="block text-xs font-mono font-bold text-theme-subtle uppercase mb-2"
                >Nama Lengkap</label
              >
              <input
                type="text"
                id="contact-name"
                required
                placeholder="Nama Anda"
                class="w-full px-4 py-3 rounded-md bg-theme-main border border-theme text-theme-main placeholder-theme-subtle text-sm focus:outline-none focus:border-brand"
              />
            </div>

            <div>
              <label
                for="contact-phone"
                class="block text-xs font-mono font-bold text-theme-subtle uppercase mb-2"
                >Nomor WhatsApp</label
              >
              <input
                type="tel"
                id="contact-phone"
                required
                placeholder="0812xxxx"
                class="w-full px-4 py-3 rounded-md bg-theme-main border border-theme text-theme-main placeholder-theme-subtle text-sm focus:outline-none focus:border-brand"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                class="block text-xs font-mono font-bold text-theme-subtle uppercase mb-2"
                >Kategori Proyek</label
              >
              <Dropdown
                id="contact-category"
                name="contactCategory"
                placeholder="Pilih Kategori Proyek"
                value="Furnitur Custom (Kitchen Set / Lemari)"
                options={categoryOptions}
              />
            </div>

            <div>
              <label
                for="contact-location"
                class="block text-xs font-mono font-bold text-theme-subtle uppercase mb-2"
                >Kota / Lokasi Proyek</label
              >
              <input
                type="text"
                id="contact-location"
                placeholder="Contoh: Bandung / Jakarta"
                class="w-full px-4 py-3 rounded-md bg-theme-main border border-theme text-theme-main placeholder-theme-subtle text-sm focus:outline-none focus:border-brand"
              />
            </div>
          </div>

          <div>
            <label
              for="contact-message"
              class="block text-xs font-mono font-bold text-theme-subtle uppercase mb-2"
              >Detail Ukuran / Keinginan</label
            >
            <textarea
              id="contact-message"
              rows="4"
              placeholder="Tuliskan gambaran singkat ukuran ruangan atau spesifikasi..."
              class="w-full px-4 py-3 rounded-md bg-theme-main border border-theme text-theme-main placeholder-theme-subtle text-sm focus:outline-none focus:border-brand resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 rounded-md bg-brand text-white font-bold text-sm hover:bg-brand-hover shadow-theme transition-all duration-200 flex items-center justify-center space-x-2 cursor-pointer"
          >
            <MessageSquare class="w-4 h-4" />
            <span>Kirim via WhatsApp</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { COMPANY_INFO } from "../../data/companyData";
  import { inView, animate } from "motion";

  inView("#kontak", () => {
    const info = document.querySelector("#kontak .lg\\:col-span-5");
    const formEl = document.querySelector("#kontak .lg\\:col-span-7");
    if (info) animate(info as any, { opacity: [0, 1], x: [-25, 0] }, { duration: 0.65, ease: "easeOut" });
    if (formEl) animate(formEl as any, { opacity: [0, 1], x: [25, 0] }, { duration: 0.65, delay: 0.1, ease: "easeOut" });
  });

  const form = document.getElementById("inquiry-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (document.getElementById("contact-name") as HTMLInputElement)
      ?.value;
    const phone = (document.getElementById("contact-phone") as HTMLInputElement)
      ?.value;
    const categoryInput = document.getElementById(
      "contact-category-input",
    ) as HTMLInputElement | null;
    const category = categoryInput?.value || "Furnitur Custom (Kitchen Set / Lemari)";
    const location = (
      document.getElementById("contact-location") as HTMLInputElement
    )?.value;
    const msg = (
      document.getElementById("contact-message") as HTMLTextAreaElement
    )?.value;

    const text = encodeURIComponent(
      `Halo Karya Sejati,\n\n*NAMA:* ${name}\n*NO WA:* ${phone}\n*KATEGORI:* ${category}\n*LOKASI:* ${location || "-"}\n\n*PESAN / UKURAN:*\n${msg || "Ingin konsultasi langsung."}`,
    );

    window.open(
      `https://wa.me/${COMPANY_INFO.whatsapp}?text=${text}`,
      "_blank",
    );
  });
</script>
