---
import { COMPANY_INFO } from "../../data/companyData";
---

<footer
  class="bg-theme-nav py-12 transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <img
          src="/kslogo.svg"
          alt="Karya Sejati Logo"
          class="h-9 w-auto object-contain shrink-0"
        />
        <span
          class="text-lg font-extrabold text-theme-main group-hover:text-brand transition-colors"
        >
          KARYA <span class="text-brand">SEJATI</span>
        </span>
      </a>

      <!-- Copyright -->
      <div
        class="text-xs text-theme-subtle text-center md:text-right font-mono"
      >
        <p>
          &copy; {new Date().getFullYear()}
          {" "}
          {COMPANY_INFO.name}. Hak Cipta Dilindungi.
        </p>
      </div>
    </div>
  </div>
</footer>
