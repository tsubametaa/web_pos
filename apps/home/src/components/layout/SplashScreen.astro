---
---

<div
  id="splash-screen"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-slate-950 transition-opacity duration-700 opacity-100 pointer-events-auto"
>
  <!-- Animated Logo -->
  <div class="relative w-24 h-24 sm:w-32 sm:h-32 splash-logo-wrapper">
    <img
      src="/kslogo.svg"
      alt="Karya Sejati Logo"
      class="w-full h-full object-contain"
    />
  </div>

  <!-- Brand name & tagline -->
  <div class="mt-6 text-center splash-text-wrapper">
    <p class="text-white text-sm font-bold tracking-widest uppercase opacity-70">
      Karya Sejati
    </p>
    <p class="text-slate-500 text-xs mt-1 tracking-wider">
      Furnitur Custom & Aluminium
    </p>
  </div>

  <!-- Loading bar -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 w-24">
    <div class="h-0.5 bg-slate-800 rounded-full overflow-hidden">
      <div class="splash-bar h-full bg-red-500 rounded-full"></div>
    </div>
  </div>
</div>

<style>
  @keyframes splashLogoAnim {
    0%   { transform: scale(0.75); opacity: 0; }
    60%  { transform: scale(1.06); opacity: 1; }
    100% { transform: scale(1);    opacity: 1; }
  }

  @keyframes splashTextAnim {
    0%   { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes splashBar {
    0%   { width: 0%; }
    100% { width: 100%; }
  }

  .splash-logo-wrapper {
    animation: splashLogoAnim 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .splash-text-wrapper {
    animation: splashTextAnim 0.5s ease forwards 0.4s;
    opacity: 0;
  }

  .splash-bar {
    animation: splashBar 1.1s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.1s;
    width: 0%;
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'ks_splash_seen';
    var splash = document.getElementById('splash-screen');
    if (!splash) return;

    if (localStorage.getItem(STORAGE_KEY)) {
      splash.style.display = 'none';
      return;
    }

    // First visit — mark as seen in localStorage, then animate & fade out
    localStorage.setItem(STORAGE_KEY, '1');

    function hideSplash() {
      splash.style.opacity = '0';
      splash.style.pointerEvents = 'none';
      setTimeout(function () {
        splash.style.display = 'none';
      }, 700);
    }

    window.addEventListener('load', function () {
      setTimeout(hideSplash, 1400);
    });

    setTimeout(hideSplash, 1600);
  })();
</script>
